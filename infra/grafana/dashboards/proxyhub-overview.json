        {
          "expr": "histogram_quantile(0.95, rate(proxyhubb_redis_batch_fetch_duration_seconds_bucket[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "rate(proxyhubb_redis_batch_fetch_duration_seconds_count[5m])",
          "legendFormat": "Ops/sec",
          "refId": "C"
