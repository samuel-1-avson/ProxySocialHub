    {
      "title": "Redis Performance",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      }
    },
    {
      "title": "Batch Fetch Duration (P95/P99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(proxyhubb_redis_batch_fetch_duration_seconds_bucket[5m]))",
          "legendFormat": "P99",
          "refId": "A"
