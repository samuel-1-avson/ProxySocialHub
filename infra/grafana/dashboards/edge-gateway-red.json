{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Edge Gateway RED (P5)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Active proxy connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "expr": "edge_gateway_active_connections", "refId": "A" }
      ]
    },
    {
      "title": "Healthy providers (this pod)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        { "expr": "edge_gateway_healthy_providers", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "title": "Connection rate (/s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(edge_gateway_total_connections[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Connection errors (/s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(edge_gateway_connection_errors[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "P99 CONNECT latency (s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(edge_gateway_request_latency_seconds_bucket{method=\"CONNECT\"}[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [
        { "expr": "edge_gateway_active_sessions", "refId": "A" }
      ]
    },
    {
      "title": "Request latency (CONNECT)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(edge_gateway_request_latency_seconds_bucket{method=\"CONNECT\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(edge_gateway_request_latency_seconds_bucket{method=\"CONNECT\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(edge_gateway_request_latency_seconds_bucket{method=\"CONNECT\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Session duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(edge_gateway_session_duration_seconds_bucket[5m])) by (le, session_type))",
          "legendFormat": "{{session_type}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Connection errors by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum(rate(edge_gateway_connection_errors[5m])) by (error_type)",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Provider route selection",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum(rate(edge_gateway_provider_route_selection_total[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Bandwidth (bytes/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "sum(rate(edge_gateway_bandwidth_bytes_total{direction=\"up\"}[5m]))",
          "legendFormat": "up",
          "refId": "A"
        },
        {
          "expr": "sum(rate(edge_gateway_bandwidth_bytes_total{direction=\"down\"}[5m]))",
          "legendFormat": "down",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "title": "Policy blocks & auth failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "sum(rate(edge_gateway_policy_blocks[5m])) by (reason)",
          "legendFormat": "policy {{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(edge_gateway_session_auth_failures[5m])) by (reason)",
          "legendFormat": "auth {{reason}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
