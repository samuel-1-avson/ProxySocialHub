# Dockerfile.dev - Development mode with hot reload
FROM node:20-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git python3 make g++ linux-headers eudev-dev

# Copy package files
COPY package.json package-lock.json* ./
RUN npm install

# Copy source code
COPY . .

# Expose port (must match package.json "dev" script -p)
EXPOSE 4001

# Environment
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=4001
ENV HOSTNAME="0.0.0.0"

# Start development server on 0.0.0.0:4001 for Docker port mapping
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "4001"]
