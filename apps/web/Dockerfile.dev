# Dockerfile.dev - Development mode with hot reload
FROM node:20-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git

# Copy package files
COPY package.json package-lock.json* ./
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 4001

# Environment
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=4001
ENV HOSTNAME="0.0.0.0"

# Start development server
CMD ["npm", "run", "dev"]
