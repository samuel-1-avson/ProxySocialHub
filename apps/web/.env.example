# Server API used by Next.js rewrites and authenticated route validation.
API_URL=http://127.0.0.1:18080

# Set before building to activate the independent explorer links.
# Until set, links keep using the legacy /explorer compatibility routes.
NEXT_PUBLIC_EXPLORER_URL=https://explorer.proxyhubb.com

# Preserve the environment used by your existing wallet and escrow deployment.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Regional Auditor (services/regional-auditor). Server-side only; never use NEXT_PUBLIC_ for these.
# URL of the auditor worker and the secret shared with it (>= 32 random characters).
AUDITOR_URL=http://127.0.0.1:4021
AUDITOR_SERVICE_SECRET=
# Opt-in: bind each session to the hosts the audit may contact (the signed intent's allowed_domains), so the
# gateway can refuse redirects elsewhere. Unverified against a live gateway; off by default.
# AUDITOR_RESTRICT_INTENT_DOMAINS=1
# Bytes of bandwidth requested per regional session opened for a live audit (default 100 MiB).
# AUDITOR_REGION_BANDWIDTH_BYTES=104857600
