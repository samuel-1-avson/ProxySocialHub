{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 4011",
    "dev:e2e": "next dev -H 0.0.0.0 -p 4011 --webpack",
    "build": "next build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:provider-config": "node scripts/provider-config-contract.mjs",
    "test:listing-display": "node scripts/listing-display-contract.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:map": "playwright test e2e/marketplace-map-proof.spec.ts e2e/marketplace-map-buy.spec.ts e2e/marketplace-listing-buy.spec.ts e2e/marketplace-browse-buy.spec.ts --project=chromium --workers=1",
    "test:e2e:moderation": "playwright test e2e/marketplace-moderation.spec.ts --project=chromium",
    "test:e2e:catalog": "playwright test e2e/marketplace-catalog.spec.ts --project=chromium",
    "test:e2e:network": "node e2e/run-network-e2e.mjs",
    "test:e2e:topology": "node e2e/run-globe-topology-e2e.mjs",
    "test:e2e:marketplace": "playwright test e2e/marketplace-map-proof.spec.ts e2e/marketplace-map-buy.spec.ts e2e/marketplace-listing-buy.spec.ts e2e/marketplace-browse-buy.spec.ts e2e/marketplace-catalog.spec.ts e2e/marketplace-moderation.spec.ts e2e/marketplace-order-credentials.spec.ts --project=chromium --workers=1",
    "test:e2e:order-credentials": "playwright test e2e/marketplace-order-credentials.spec.ts --project=chromium --workers=1",
    "test:e2e:map-buy": "playwright test e2e/marketplace-map-buy.spec.ts --project=chromium",
    "test:e2e:map-buy:devnet:check": "node e2e/check-live-map-buy-env.mjs",
    "test:e2e:map-buy:devnet": "npm run test:e2e:map-buy:devnet:check && playwright test e2e/marketplace-map-buy.devnet.spec.ts --project=chromium",
    "test:e2e:governance:devnet:check": "node e2e/check-live-governance-env.mjs",
    "test:e2e:governance:devnet": "npm run test:e2e:governance:devnet:check && playwright test e2e/governance.devnet.spec.ts --project=chromium",
    "test:e2e:governance:smoke": "playwright test e2e/governance.smoke.spec.ts --project=chromium"
  },
  "dependencies": {
    "@moonpay/moonpay-js": "^0.7.6",
    "@noble/ed25519": "^3.1.0",
    "@polkadot/extension-dapp": "^0.62.6",
    "@polkadot/keyring": "^14.0.1",
    "@polkadot/util": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "@project-serum/anchor": "^0.26.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.90.19",
    "@types/leaflet": "^1.9.21",
    "@types/supercluster": "^7.1.3",
    "@types/three": "^0.183.1",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.27.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "pg": "^8.17.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-globe.gl": "^2.37.0",
    "react-markdown": "^10.1.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.183.2",
    "viem": "^2.44.4",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
