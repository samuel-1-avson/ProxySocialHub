# ProxyHub Admin App — Environment Variables
# Copy to .env.local and fill in values

# API Backend URL (same control-api backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ──────────────────────────────────────────────────────────────────────────────
# Admin Credentials — stored as env vars on the BACKEND (control-api)
# Change these immediately in production!
#
# ADMIN_ACCOUNT_1_USERNAME=superadmin
# ADMIN_ACCOUNT_1_PASSWORD=PHub@Super2026!
# ADMIN_ACCOUNT_1_ROLE=superadmin
#
# ADMIN_ACCOUNT_2_USERNAME=sysops
# ADMIN_ACCOUNT_2_PASSWORD=PHub@Ops2026!
# ADMIN_ACCOUNT_2_ROLE=sysops
#
# ADMIN_ACCOUNT_3_USERNAME=support
# ADMIN_ACCOUNT_3_PASSWORD=PHub@Support2026!
# ADMIN_ACCOUNT_3_ROLE=support
#
# ADMIN_JWT_SECRET=<generate a strong random secret, separate from JWT_SECRET>
# ──────────────────────────────────────────────────────────────────────────────
