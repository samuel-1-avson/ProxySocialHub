{
  "manifest_version": 3,
  "name": "ProxyHubb",
  "version": "0.7.0",
  "description": "Turn on the proxy for your ProxyHubb purchases in one click. Not a VPN.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://proxyhubb.com",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "scripting",
    "webRequest",
    "webRequestAuthProvider",
    "privacy"
  ],
  "host_permissions": [
    "https://api.proxyhubb.com/*",
    "https://proxyhubb.com/*",
    "https://*.proxyhubb.com/*",
    "http://localhost:18080/*",
    "http://127.0.0.1:18080/*",
    "http://localhost:4011/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://proxyhubb.com/*",
        "https://*.proxyhubb.com/*",
        "http://localhost:3009/*",
        "http://localhost:8088/*",
        "http://localhost:4011/*",
        "http://127.0.0.1:4011/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://proxyhubb.com/*",
      "https://*.proxyhubb.com/*",
      "http://localhost:4011/*",
      "http://127.0.0.1:4011/*"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@proxyhubb.com",
      "strict_min_version": "128.0"
    }
  },
  "incognito": "spanning",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "ProxyHubb",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
