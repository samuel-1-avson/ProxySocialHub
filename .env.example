# ProxyHub Environment Template
# Copy to .env and fill in ALL values before running docker-compose up.
# DO NOT commit the real .env file — it is listed in .gitignore.
# Generate strong random secrets with: openssl rand -hex 32

# ============================================
# REQUIRED SECRETS (Generate strong values)
# ============================================
JWT_SECRET=                         # openssl rand -hex 32
# Bulk pool endpoint password HMAC (falls back to JWT_SECRET). Required in staging/prod if JWT_SECRET unset.
# BULK_ENDPOINT_HMAC_SECRET=
GATEWAY_SHARED_SECRET=              # openssl rand -hex 32  — dedicated edge-gateway -> control-api auth secret
SESSION_SECRET=                     # openssl rand -hex 32  — signs session-intent delegation tokens
ENCRYPTION_KEY=                     # openssl rand -hex 32
ADMIN_JWT_SECRET=                   # openssl rand -hex 32  — separate key for admin tokens
TOKEN_HMAC_SECRET=                  # openssl rand -hex 32  — HMAC key for provider CLI tokens (min 32 chars)
EMAIL_HASH_PEPPER=                  # openssl rand -hex 32  — preferred pepper for profiles.email_hash (falls back to TOKEN_HMAC_SECRET if unset)

# Platform assistant — Meta Model API, passed to the web service at runtime.
# MODEL_API_KEY=
# ASSISTANT_MODEL=muse-spark-1.3
# ASSISTANT_ENABLED=0               # Disable live AI; keep local help guides.
# REDIS_URL=redis://:PASSWORD@redis:6379  # Hubbie rate limits shared across web replicas; without it, limits are per process.

# ============================================
# ALERT CHANNELS (Strongly recommended for production)
# ============================================
ALERT_WEBHOOK_URL=                  # optional self-hosted webhook (ntfy/Matrix/custom) — not Slack
ALERT_ADMIN_EMAILS=                 # optional; unused by default platform journal path
# Durable alerts: Postgres ops_alerts + NATS proxy.ops.v1.alerts (no SaaS Slack/PagerDuty)
INTERNAL_ALERT_WEBHOOK_TOKEN=       # Grafana → POST /internal/alerts/webhook
# Optional SMTP (self-hosted mail only)
SMTP_USERNAME=                      # SMTP login username for alert delivery
SMTP_PASSWORD=                      # SMTP password for alert delivery
SMTP_FROM=                          # Sender address: alerts@proxyhubb.com

# ============================================
# DATABASE
# ============================================
DATABASE_URL=                       # postgresql://user:pass@host:5432/db?sslmode=disable
# Optional: PostgreSQL read-replica for analytics/search queries (falls back to primary if unset)
READ_REPLICA_URL=                   # postgresql://user:pass@replica-host:5432/db?sslmode=disable
POSTGRES_USER=proxyhubb
POSTGRES_PASSWORD=                  # Strong password — never use the default "proxyhubb"
# If db-migrate fails with "password authentication failed", the Postgres volume password
# does not match POSTGRES_PASSWORD (or a shell export overrides .env). Fix:
#   .\scripts\compose-heal-postgres-password.ps1
POSTGRES_DB=proxyhubb
# Set to "true" to force schema re-migration on next startup (then set back to false)
FORCE_MIGRATE=false
# Set to "true" ONLY in migration init-containers/jobs, never on normal API pods (I1)
AUTO_MIGRATE=false

# GORM query logger (E8): silent | error | warn | info  (default: warn)
DB_LOG_LEVEL=warn
# Slow-query threshold in milliseconds (E8, default: 500ms)
DB_SLOW_QUERY_MS=500

# ============================================
# REDIS
# ============================================
REDIS_URL=                          # redis://:PASSWORD@redis:6379  (password is required)
REDIS_PASSWORD=                     # Strong password — required; redis is AUTH-enabled

# ============================================
# SUPABASE CONFIGURATION
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Direct PostgreSQL connection string for Supabase (used by GORM for social tables).
# IMPORTANT: Use port 5432 (Session Pooler), NOT port 6543 (Transaction Pooler).
# GORM manages its own connection pool; Transaction Pooler resets search_path on every
# transaction which breaks GORM's AutoMigrate (SQLSTATE 3F000).
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Get it from: Supabase Dashboard → Settings → Database → Connection string → Session mode
# Leave blank to keep all tables in local PostgreSQL (Docker).
SUPABASE_DATABASE_URL=
# Public Supabase vars — exposed to the browser bundle (Next.js NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================
# PAYMENT GATEWAYS
# ============================================
# Paystack is used only for buyers with a ProxyHubb-managed wallet (Google sign-in).
# They pay in GHS; the treasury sends the SOL to their managed wallet and the server
# signs the normal on-chain escrow. Wallet users still pay from their own wallet.
# Use a test key (sk_test_...) until live mode is approved.
# Webhook URL to set in the Paystack dashboard: https://<api-host>/v1/webhooks/paystack
FIAT_PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
# Added on top of the quote to cover Paystack fees and FX movement (percent).
PAYSTACK_FEE_BUFFER_PCT=4
# Per-order and per-user 24h caps, in GHS.
FIAT_MAX_ORDER_GHS=2000
FIAT_DAILY_LIMIT_GHS=5000
# Optional fixed USD->GHS rate (dev or emergency). Empty = live rate.
FX_USD_GHS_OVERRIDE=
# Cash out to Mobile Money for providers with a ProxyHubb-managed wallet. Needs
# PAYSTACK_SECRET_KEY, a funded Paystack balance and transfer OTP turned off
# (Paystack dashboard -> Settings -> Preferences).
CASHOUT_ENABLED=false
CASHOUT_MIN_GHS=5
CASHOUT_MAX_GHS=2000
CASHOUT_DAILY_LIMIT_GHS=5000
# Flat fee per cash-out and a buffer for FX movement (percent).
CASHOUT_FLAT_FEE_GHS=1
CASHOUT_FEE_BUFFER_PCT=3

# ============================================
# OAUTH PROVIDERS
# ============================================
# Google sign-in (Google Identity Services). Web application OAuth client ID from
# Google Cloud Console; add your site origin (e.g. http://localhost:3009) under
# "Authorized JavaScript origins". Empty = Google sign-in hidden and disabled.
# The same value is passed to the web build as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Embedded wallet custody: gcp-kms is required in production/staging/testnet.
# Use a dedicated symmetric ENCRYPT_DECRYPT key, separate from oracle/treasury.
# Authentication uses ADC/workload identity, never a raw cloud key in this file.
EMBEDDED_WALLET_KEK_PROVIDER=local
EMBEDDED_WALLET_GCP_KMS_KEY=
# Optional dedicated custody identity, impersonated using workload ADC.
EMBEDDED_WALLET_GCP_KMS_SERVICE_ACCOUNT=
# Comma-separated historical CryptoKey resources; reads only, maximum eight.
EMBEDDED_WALLET_GCP_KMS_READ_KEYS=
# HSM default; SOFTWARE must be an explicit operator choice (also enforced on reads).
EMBEDDED_WALLET_KMS_PROTECTION_LEVEL=HSM
# Local development only: 32 bytes hex, separate from ENCRYPTION_KEY.
# Losing either a local KEK or an in-use KMS version makes wallets unrecoverable.
EMBEDDED_WALLET_KEK=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# SMTP CONFIGURATION
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================
# BLOCKCHAIN
# ============================================
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
# Comma-separated list of RPC endpoints for failover (primary,secondary,tertiary)
SOLANA_RPC_ENDPOINTS=https://api.devnet.solana.com
# WebSocket endpoint for real-time event subscription
SOLANA_WS_ENDPOINT=wss://api.devnet.solana.com
SOLANA_NETWORK=devnet               # devnet | mainnet-beta
SOLANA_PROGRAM_ID=                  # Deployed escrow program (see docs/SOLANA_PROGRAM_DEPLOYMENT.md). Local E2E: AZGhGfvsiGJQ5S91nkdhGi9qvSNKv3sBZyVJ63KQLfvu
NEXT_PUBLIC_SOLANA_PROGRAM_ID=      # Web client — must match SOLANA_PROGRAM_ID
SOLANA_TREASURY_ADDRESS=            # Legacy deposit EOA during dual-write (NOT the oracle)
SOLANA_DEPOSIT_VAULT_ADDRESS=       # Program deposit_vault PDA (seeds: ["deposit_vault"])
SOLANA_TREASURY_HOT_ADDRESS=        # Operational payout wallet pubkey (MUST differ from oracle)
SOLANA_TREASURY_COLD_ADDRESS=       # Optional cold storage pubkey (MUST differ from oracle and hot)
SOLANA_TREASURY_HOT_MIN_BALANCE=0.1 # Dev: 0.1; staging/testnet often 5–10; prod often 100+
SOLANA_TREASURY_HOT_MAX_BALANCE=10   # Dev/staging ceiling for hot float
SOLANA_TREASURY_REPLENISH_AMOUNT=2   # Vault→hot (or cold→hot proposal) size
SOLANA_VAULT_TOPUP_MAX_SOL=5         # Cap per auto vault→hot
SOLANA_VAULT_DAILY_TOPUP_CAP_SOL=50  # Aggregate daily vault→hot cap
SOLANA_VAULT_RESERVE_FLOOR_SOL=0.01  # Never drain vault below this + rent
SOLANA_TREASURY_SWEEP_ENABLED=true   # Propose multi-sig hot→cold when hot > HOT_MAX
# Phase 1 deposit vault / escrow flags (safe defaults)
PROXYHUB_DEPOSIT_VAULT_CREDIT_ENABLED=false
PROXYHUB_DEPOSIT_LEGACY_TREASURY_CREDIT=true
PROXYHUB_DEPOSIT_VAULT_UI=false
# BC-07: when unset, staging/production default to finalized; set explicitly for local/dev.
PROXYHUB_DEPOSIT_REQUIRE_FINALIZED=false
PROXYHUB_REQUIRE_ESCROW_PDA=false
PROXYHUB_REQUIRE_SESSION_PDA=false
# Wave 3.1 / DISC-01: gate session activation on on-chain ProviderRegistry.
# off | observe | enforce (default off). gcp-testnet should use observe first.
PROXYHUB_PROVIDER_REGISTRY_GATE=enforce
# off | observe | enforce — gcp-testnet compose defaults to enforce (selection/activation).
# Browse/discovery stays honesty-only (does not hard-filter the catalog).
# Max age of ProviderRegistry.last_heartbeat for "live" (default 30m).
# PROXYHUB_PROVIDER_REGISTRY_HEARTBEAT_MAX_AGE=30m
# Wave 3.3: attach HMAC credential_proof on GET /orders/:id/credentials (observe only).
PROXYHUB_CREDENTIAL_PROOF=off
# Wave 7.A: Ed25519 session capability (off|observe|enforce). Default off.
# Enforce admits marketplace CONNECT by local verify (no control-api at CONNECT).
# W7.C: enforce + CONNECT password phubb1.<token> does not need Redis session:.
# Remaining SPOF is the token issuer. Issuer may still be control-api at mint.
# PROXYHUB_SESSION_CAPABILITY=off
# PROXYHUB_SESSION_CAPABILITY_SIGNING_KEY=   # base58 Ed25519 seed (32) or key (64)
# PROXYHUB_SESSION_CAPABILITY_ISSUER_PUBKEY= # base58 32-byte pubkey (edges; comma-separated allowlist)
# Wave 7.B: operator manifest bundle pin (file / URL / CID). Empty = Postgres-only directory.
# PROXYHUB_OPERATOR_BUNDLE_PATH=
# PROXYHUB_OPERATOR_BUNDLE_URL=
# PROXYHUB_OPERATOR_BUNDLE_CID=
# Wave 7.D: org boundary. Host-B in this GCP project is still same_org.
# PROXYHUB_PLATFORM_ORG_ID=gen-lang-client-0022105784
# GATEWAY_OP_A_ORG_ID=
# GATEWAY_OP_B_ORG_ID=
# Wave 3.5: seller appeal window after delist (days).
PROXYHUB_LISTING_APPEAL_DAYS=7
# Wave 4.1 / BC-11-B: require BN254 Groth16 on-chain batch verify.
# Default false. When true, ZK batch settlement fail-closes until READY is set
# (do NOT enable on mainnet / gcp-testnet until onchain-groth16 program is deployed).
PROXYHUB_ZK_ONCHAIN_GROTH16=false
# Flip only after proxyhub is rebuilt with --features onchain-groth16 and redeployed.
PROXYHUB_ZK_ONCHAIN_GROTH16_READY=false
# BN254 Groth16 prover HTTP service (batch header circuit matching on-chain VK).
# GROTH16_PROVER_URL=http://localhost:8096
# GROTH16_PROVER_REQUIRED=false
# When PROXYHUB_ZK_ONCHAIN_GROTH16=true, aggregator requires GROTH16_PROVER_URL.
# Wave 4.2 / BC-11-C: reputation program (devnet). Do NOT set this to SOLANA_PROGRAM_ID.
REPUTATION_PROGRAM_ID=EnVE6ehKA2dYi69B3Lo8wt2wyDgzLw4tdtSEKoMYe5bF
# Wave 4.3: protocol fee/reward observe ledger (off|observe). Never mints.
PROXYHUB_PROTOCOL_INCENTIVES=off
# Wave 4.4: JWT admin must NOT halt Solana program by default.
PROXYHUB_OPS_ONCHAIN_PAUSE=false
# PROXYHUB_GOV_TREASURY_AUTO_SPEND=false
# PROXYHUB_PROTOCOL_FEE_BPS=500
# PROXYHUB_INCENTIVE_PROVIDER_SHARE_BPS=6000
# PROXYHUB_INCENTIVE_GATEWAY_SHARE_BPS=2000
# W1.3: gcp-testnet defaults these true. Flip prod defaults to true only after
# W1.1 Session PDA fail-closed is proven on live (edge 402 + escrow_confirmed_at).
# PROXYHUB_ALLOW_ADMIN_DISPUTE_FORCE_RESOLVE=false
# M4 journal-as-SoT (default off). When true, Credit/Debit post journal first.
PROXYHUB_JOURNAL_AS_SOT=false
# Shadow wallet vs Σ2100 during recon (defaults on when JOURNAL_AS_SOT=true).
# PROXYHUB_JOURNAL_SHADOW_READ=true
# Path to oracle keypair JSON file (64-byte Solana keygen array, NOT "[]").
# Oracle signs settle/attest only — do NOT fund user withdrawals from this key.
# Docker mounts ./infra/oracle-keypair.json into the container.
# PRODUCTION: Use a secrets manager (GCP Secret Manager / AWS KMS / Vault). Never leave
# keypairs on developer workstations (BC-09).
ORACLE_KEYPAIR_PATH=./infra/oracle-keypair.json
SOLANA_ORACLE_KEYPAIR=./infra/oracle-keypair.json
# BC-08: separate payout wallet. Required in APP_ENV=production.
SOLANA_TREASURY_HOT_KEYPAIR=./treasury-keypair.json
ORACLE_PRIVATE_KEY=
PROVIDER_PRIVATE_KEY=

# Oracle velocity limits (P0.3 security controls)
ORACLE_MAX_SINGLE_TRANSFER_SOL=50    # Hard cap per single tx (default: 50 SOL)
ORACLE_MAX_HOURLY_OUTFLOW_SOL=500    # Rolling 1-hour outflow cap (default: 500 SOL)
ORACLE_TRANSFER_FREEZE=false         # Set to "true" to freeze ALL oracle transfers immediately
FULL_DECENTRALIZATION=true           # Set to true to disable centralized fallbacks and require chain-authoritative flows

# Access Passes (NFT entitlement — replaces custodial subscriptions)
# Configure SPL mint addresses; entitlement uses OracleClient.HasNFT (ATA balance > 0).
MINT_BRONZE_PASS=                    # Bronze Access Pass mint (base58)
MINT_SILVER_PASS=                    # Silver Access Pass mint (replaces Pro)
MINT_GOLD_PASS=                      # Gold Access Pass mint (replaces Scale; also used as premium session boost)
MINT_PREMIUM_PASS=                   # Optional alias for session +20% bandwidth (falls back to MINT_GOLD_PASS)
# Primary-sale prices (SOL paid to treasury from linked wallet)
PASS_BRONZE_PRICE_SOL=0.5
PASS_SILVER_PRICE_SOL=2.0
PASS_GOLD_PRICE_SOL=5.0
# Optional external marketplace / candy-machine URLs (skips treasury transfer flow)
PASS_BRONZE_PURCHASE_URL=
PASS_SILVER_PURCHASE_URL=
PASS_GOLD_PURCHASE_URL=
# Optional overrides for Free/Bronze/Silver/Gold caps (governance can also set these)
# PASS_FREE_BANDWIDTH_GB=10
# PASS_FREE_LISTINGS=2
# PASS_BRONZE_BANDWIDTH_GB=50
# PASS_BRONZE_LISTINGS=10
# PASS_SILVER_BANDWIDTH_GB=200
# PASS_SILVER_LISTINGS=25
# PASS_GOLD_LISTINGS=0               # 0 = unlimited
# Explorer public API (default off in production; enable for local dev / docker-compose.dev.yml)
EXPLORER_PUBLIC_SESSIONS_ENABLED=false
EXPLORER_PUBLIC_EARNINGS_ENABLED=false
# Web UI: hide Explorer tabs when API feeds are disabled (mirror control-api flags above)
NEXT_PUBLIC_EXPLORER_PUBLIC_SESSIONS_ENABLED=false
NEXT_PUBLIC_EXPLORER_PUBLIC_EARNINGS_ENABLED=false
# In-map buy on /explorer/map (requires wallet; default off)
NEXT_PUBLIC_EXPLORER_MAP_BUY_ENABLED=false
# Unified network home at /network (on in local/staging; set false for prod until rollout)
NEXT_PUBLIC_UNIFIED_NETWORK=true
# Phase 5: session-derived topology arcs on legacy explorer globe (default off)
NEXT_PUBLIC_GLOBE_TOPOLOGY=false
# Legacy WebGL globe on /explorer/map (default off; Google 2D/tilt-3D is primary)
NEXT_PUBLIC_LEGACY_EXPLORER_GLOBE=false
# Live node WS updates on /marketplace/map (default off)
NEXT_PUBLIC_MAP_LIVE_ON_MARKETPLACE=false
# Google Maps JavaScript API — sourced from GCP (do not invent keys locally).
# Sync: bash scripts/gcp-sync-google-maps-key.sh
# Secret Manager: proxyhubb-google-maps-api-key
# API Keys console: "ProxyHubb Maps JavaScript" (maps-backend + tile)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Cloud Map ID (vector + Advanced Markers). Secret: proxyhubb-google-maps-map-id
# Current GCP MapConfig: "ProxyHubb Explorer/Marketplace" (VECTOR, ROADMAP).
# Assign a dark cloud style in Maps → Map Management if you want cloud basemap styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Explorer public API (gate + metrics + indexer)
EXPLORER_MIN_WRITERS=2               # Min unique writers for /v1/explorer/* when FULL_DECENTRALIZATION=true (default: 2)
EXPLORER_METRICS_ENABLED=true        # Hourly/daily rollup into explorer_metrics (set false to disable)
EXPLORER_METRICS_INTERVAL=10m        # Aggregator tick: 10m, 1h, etc.
EXPLORER_INDEXER_ENABLED=true        # On-chain explorer indexer worker
EXPLORER_INDEXER_POLL_INTERVAL_MS=5000
# EXPLORER_INDEXER_WRITER_ID=
# EXPLORER_INDEXER_SIGNING_PUBLIC_KEY=
# EXPLORER_INDEXER_SIGNING_PRIVATE_KEY=

# ============================================
# PRICE FEEDS (Multi-Source)
# ============================================
# Primary: CoinGecko - Get API key from: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Emergency SOL price fallback (USD). Used ONLY when all live feeds AND Redis cache fail.
# Update this value manually when feeds are down. Check: https://coinmarketcap.com/currencies/solana/
EMERGENCY_SOL_PRICE_USD=200
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Secondary: CoinMarketCap (optional) - Get API key from: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=

# Tertiary: Binance (no API key required, used automatically)

# Price feed uses automatic failover: CoinGecko -> Binance -> CoinMarketCap
# If all sources fail, falls back to hardcoded default (200 USD/SOL)

# ============================================
# TREASURY MANAGEMENT
# ============================================
# Path to reserve wallet keypair for auto-topup (optional)
SOLANA_RESERVE_KEYPAIR_PATH=
# Override default thresholds (optional)
# PROXYHUB_JOURNAL_DRIFT_ALERTS=0   # Testnet: log journal dual-write drift but do not critical-page (M4 still open)

# ============================================
# SPENDING LIMITS (Security)
# ============================================
# Default spending limits are applied based on user's trust tier:
# - New users: 10 SOL/day, 50 SOL/week, 100 SOL/month
# - Verified users: 50 SOL/day, 200 SOL/week, 500 SOL/month  
# - Premium users: 100 SOL/day, 500 SOL/week, 2000 SOL/month
# Users can set lower limits via API. 0 = unlimited.
# Limits apply to: usage charges, P2P transfers, SOL withdrawals

# ============================================
# BATCH PAYOUT PROCESSING (Gas Optimization)
# ============================================
# Provider payouts are batched for gas efficiency (~30% savings)
# Default config (can be overridden in code):
# - Immediate threshold: 10 SOL (bypass queue)
# - Max batch size: 20 payouts per transaction
# - Min batch size: 5 payouts (wait for more if fewer)
# - Max wait time: 30 minutes
# - Process interval: 15 minutes

# ============================================
# EDGE GATEWAY
# ============================================
EDGE_GATEWAY_PORT=8090
# Host port for edge-gateway /metrics (container stays 9090). Use 9092 if 9090 is taken by Prometheus.
EDGE_GATEWAY_METRICS_PORT=9092
EDGE_GATEWAY_MGMT_URL=http://edge-gateway:8090
EDGE_GATEWAY_BUYER_HOST=proxy.proxyhubb.com
EDGE_GATEWAY_BUYER_PORT=8090
# METRICS_PORT=9090                 # Prometheus /metrics only; 0 or unset = legacy on PORT

# P5 buyer TLS (optional; default off — plain HTTP/h2c on PORT)
# BUYER_ACCEPT_WORKERS=4          # Linux only: parallel accept loops with SO_REUSEPORT (default 1)
# BUYER_TLS_ENABLE=1
# BUYER_TLS_CERT_FILE=/path/to/cert.pem   # falls back to TLS_CERT_FILE / TLS_CERT_PATH
# BUYER_TLS_KEY_FILE=/path/to/key.pem     # falls back to TLS_KEY_FILE / TLS_KEY_PATH
# Provider tunnel TLS (separate listener on TUNNEL_PORT) uses TLS_CERT_* when set.

# P6 protocol expansion (optional)
# ENABLE_SOCKS5=1
# SOCKS5_HOST=0.0.0.0
# SOCKS5_PORT=1080
# ENABLE_HTTP3_INGRESS=1          # requires edge-gateway built with --features quic
# HTTP3_HOST=0.0.0.0
# HTTP3_PORT=8443
# HTTP3_TLS_CERT_FILE=/path/to/cert.pem   # falls back to BUYER_TLS_CERT_FILE / TLS_CERT_FILE
# HTTP3_TLS_KEY_FILE=/path/to/key.pem     # falls back to BUYER_TLS_KEY_FILE / TLS_KEY_FILE

# P5 OpenTelemetry (optional; compile with EDGE_GATEWAY_ENABLE_OTEL=1 on docker build)
# EDGE_GATEWAY_ENABLE_OTEL=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=edge-gateway

# Session Cache Configuration (edge-gateway)
# No inline comments on this line — edge-gateway parses the value as an integer only.
SESSION_CACHE_SIZE=100000
SESSION_CACHE_TTL_SECS=300          # Session cache TTL in seconds (default: 300)

# P1 hot-path performance (edge-gateway)
MAX_CONCURRENT_CONNECTIONS=8192     # Buyer TCP admission limit (default: 8192)
MAX_RPM_PER_SESSION=300               # Anomaly block threshold (CONNECT RPM per session)
CB_FAILURE_THRESHOLD=3                # Provider circuit: failures before open
CB_OPEN_TIMEOUT_SECS=30               # Provider circuit: open → half-open wait
CB_SUCCESS_THRESHOLD=2                # Provider circuit: successes to close
CB_REQUEST_TIMEOUT_SECS=30            # Provider circuit: per-request timeout (defaults to PROXY_CONNECT_TIMEOUT_SECS)
SCORE_SNAPSHOT_REFRESH_MS=100         # Debounced provider score snapshot tick (default: 100)
EDGE_POD_ID=                          # Stable pod id (K8s: HOSTNAME/POD_NAME); required for multi-replica P3
EDGE_MODE=single                      # single | colocated (P3 multi-pod directory + peer forward)
PROVIDER_DIRECTORY_TTL_SECS=120       # Redis TTL for eg:provider:owner:* keys
EDGE_PEER_URLS=                       # P3.2: pod-a@http://edge-a:8090,pod-b@http://edge-b:8090

# D-L1: Leader election NATS fallback
# Edge gateway uses Redis as primary leader election backend.
# When Redis fails 3+ consecutive ticks, it falls back to NATS JetStream KV.
# Set to the same NATS cluster used by the rest of the stack.
NATS_URL=nats://nats:4222

# ============================================
# PROVIDER NODE (CLI — not a Docker service)
# ============================================
# Provider nodes are standalone CLI daemons run by bandwidth providers on their
# own machines.  They connect to the edge gateway(s) listed below.
#
# D-GW: Multi-gateway failover — comma-separated ordered list of gateway
# addresses (host:port). The provider node rotates through these on each
# reconnect so a single gateway outage does not take the provider offline.
# Set PROXYHUB_GATEWAY_ADDRS when deploying provider nodes alongside this stack
# (TUNNEL_PORT=3128 is the provider tunnel port):
#   PROXYHUB_GATEWAY_ADDRS=edge-gateway:3128,gateway2.example.com:3128
PROXYHUB_GATEWAY_ADDRS=            # comma-separated gateway addresses for provider-node failover

# ============================================
# WEBSOCKET / REAL-TIME
# ============================================
# Public WebSocket URL used by the browser for the real-time explorer (useExplorerWS hook).
# In production set to wss://your-domain.com (same host as API_BASE_URL, different scheme).
# In development with docker-compose this defaults to ws://localhost:8080 or ws://localhost:8081.
WS_PUBLIC_URL=ws://localhost:8080

# Buyer HTTP proxy URL (edge-gateway PORT, not the provider tunnel port).
# Buyer HTTP proxy / health (port 8090). Provider tunnels use TUNNEL_PORT (3128).
# P4: parallel yamux sessions per provider on the gateway (provider-node must open N tunnels when >1).
# YAMUX_CONNS_PER_NODE=1
# Provider tunnel wire protocol on edge-gateway (buyer proxy is unchanged).
# docker-compose.provider.yml forces quic on gateway + provider-node; plain compose up uses yamux.
# PROVIDER_TRANSPORT=yamux
GATEWAY_PUBLIC_URL=http://localhost:8090
# Buyer HTTP CONNECT host:port shown in dashboard curl examples (edge-gateway buyer port, not tunnel 3128).
NEXT_PUBLIC_PROXY_ENDPOINT=localhost:8090
# Browser extension. The site finds it through its content script, so no ID is
# needed; the store URLs power the order page's "Add to Chrome / Add to Firefox".
# Leave them empty until the listings are live (never invent a store link).
# NEXT_PUBLIC_EXTENSION_CWS_URL=https://chromewebstore.google.com/detail/<item-id>
# NEXT_PUBLIC_EXTENSION_AMO_URL=https://addons.mozilla.org/firefox/addon/<slug>/
# Optional: Chrome ID for extension builds older than 0.7.0 (32 chars a–p).
# NEXT_PUBLIC_EXTENSION_ID=
# Dev-only: POST /v1/orders/:id/activate-dev simulates escrow confirmation (docker E2E; never enable in prod).
PROXYHUB_ALLOW_DEV_ESCROW_ACTIVATE=false
# Public addresses embedded in dashboard-downloaded provider.toml
PROVIDER_TUNNEL_PUBLIC_ADDR=localhost:3128
PROVIDER_PUBLIC_CONTROL_API_URL=http://localhost:18080

# ============================================
# APP URL (WebSocket CORS)
# ============================================
# Used to validate WebSocket upgrade Origin header.
# Set to your frontend public URL (e.g. https://proxyhubb.com).
# Leave EMPTY in development to allow all origins.
APP_URL=

# ============================================
# PLATFORM TOKEN
# ============================================
# SPL token mint address for the ProxyHub platform token (PHB).
# Used to display platform token balances on the wallet details page.
# Leave blank if not deployed yet.
PHB_TOKEN_MINT=
# Governance proposal description → IPFS.
# Prefer PINATA_JWT when set. GCP testnet overlay runs Kubo at IPFS_NODE_URL.
# PINATA_JWT=
# GOVERNANCE_IPFS_STUB=0
# IPFS_NODE_URL=http://ipfs:5001
# IPFS_GATEWAY=http://ipfs:8080/ipfs/

# ============================================
# MONITORING — Grafana
# ============================================
# REQUIRED: Set a strong password. No default is provided for security.
GRAFANA_ADMIN_PASSWORD=             # Strong password for Grafana admin access

# ============================================
# ADMIN ACCOUNTS (Control API)
# Three admin accounts supported. All fields required if used.
# ============================================
ADMIN_ACCOUNT_1_USERNAME=
ADMIN_ACCOUNT_1_PASSWORD=           # Strong password
ADMIN_ACCOUNT_1_ROLE=admin
ADMIN_ACCOUNT_1_TOTP_SECRET=        # base32 TOTP secret — leave blank to disable MFA for this account
ADMIN_ACCOUNT_2_USERNAME=
ADMIN_ACCOUNT_2_PASSWORD=
ADMIN_ACCOUNT_2_ROLE=admin
ADMIN_ACCOUNT_2_TOTP_SECRET=        # base32 TOTP secret — leave blank to disable MFA for this account
ADMIN_ACCOUNT_3_USERNAME=
ADMIN_ACCOUNT_3_PASSWORD=
ADMIN_ACCOUNT_3_ROLE=moderator
ADMIN_ACCOUNT_3_TOTP_SECRET=        # base32 TOTP secret — leave blank to disable MFA for this account

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Set DEV_LOGIN_SECRET to enable the /auth/dev/login backdoor endpoint.
# Leave EMPTY in production — endpoint is disabled when APP_ENV != development.
DEV_LOGIN_SECRET=                   # openssl rand -hex 16  — leave blank in production
# GO_ENV is separate from APP_ENV; align them to avoid CORS confusion.
GO_ENV=development

# ============================================
# APPLICATION
# ============================================
APP_ENV=development                 # development | production
# debug | release (use release in production)
GIN_MODE=debug
PORT=8080
# Peers allowed to set X-Forwarded-For for c.ClientIP() (WAF / rate limits / KYC).
# Default (unset): 127.0.0.1,::1 — host Caddy → loopback API on GCP Phase A.
# Use comma-separated IPs/CIDRs for an extra reverse proxy, or "none" to ignore XFF.
# TRUSTED_PROXIES=127.0.0.1,::1

API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://proxyhubb.com  (apex only; www/app 301 via Caddy)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Production: CORS_ORIGINS=https://proxyhubb.com

# ============================================
# PROVIDER ENGINE
# ============================================
# Supabase JWT secret — required for provider token auth middleware to validate user JWTs.
# Find it in Supabase dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Platform commission taken from each provider payout (0.0 to 1.0, default 10%)
PLATFORM_FEE_PERCENT=0.10

# Minimum SOL amount before a provider payout is disbursed
MIN_PAYOUT_SOL=0.01

# Batch payout: number of payouts grouped per Solana transaction
PAYOUT_BATCH_SIZE=20

# ============================================
# SESSION CREDENTIAL MIGRATION (I3)
# ============================================
# Set to "true" on ONE pod/job to encrypt existing plaintext credentials.
# Revert to "false" once the one-time migration completes.
MIGRATE_CREDENTIALS=false

# ============================================
# MATERIALISED VIEW REFRESH (E2)
# ============================================
# How often (minutes) to refresh mv_provider_leaderboard (default: 15)
MV_LEADERBOARD_REFRESH_MINS=15

# ============================================
# GEOIP BACKFILL WORKER
# ============================================
# Resolves latitude/longitude for explorer nodes that have an IP address but
# no coordinates yet. Uses the ip-api.com free JSON endpoint (no API key
# required, rate-limited to 45 req/min). The worker runs as a background
# goroutine inside the control-api container.
#
# NOTE: The container needs outbound HTTP access to https://ip-api.com and
# https://api.ipify.org (WAN IP detection when nodes register private Docker IPs).
# Set to "false" in air-gapped environments or when coordinates are
# already populated via another source (e.g. MaxMind GeoLite2).
GEOIP_ENABLED=true

# Phase 5: aggregate active session_intents into map_node_links for globe topology arcs
MAP_TOPOLOGY_ENABLED=true

# Optional override for public WAN IP detection (default: api.ipify.org)
# GEOIP_PUBLIC_IP_ENDPOINT=https://api.ipify.org?format=text

# MaxMind GeoLite2 license key — required for the weekly GeoIP auto-update
# cron job inside the edge-gateway container. Get a free key at:
# https://www.maxmind.com/en/geolite2/signup
# Leave blank to disable automatic GeoIP database updates.
MAXMIND_LICENSE_KEY=
# ============================================
# PAYG SOCIAL SYSTEM (Phases 1-4)
# ============================================
# New social features for the Pay-As-You-Go model

# --- Milestone Worker Configuration ---
# How often to check for usage milestones (minutes, default: 5)
MILESTONE_CHECK_INTERVAL_MINUTES=5

# Enable/disable milestone rewards (default: true)
MILESTONE_REWARDS_ENABLED=true

# --- Review System Configuration ---
# Minimum GB used before user can review (default: 1)
REVIEW_MIN_USAGE_GB=1

# Minimum days of usage before user can review (default: 7)
REVIEW_MIN_DURATION_DAYS=7

# --- Circle Pool Configuration ---
# Enable/disable circle bandwidth pooling (default: true)
CIRCLE_POOL_ENABLED=true

# Minimum bandwidth to form a pool (GB, default: 100)
CIRCLE_MINIMUM_POOL_GB=100

# Threshold for enterprise-grade pools (GB, default: 1000)
CIRCLE_ENTERPRISE_THRESHOLD_GB=1000

# --- Presence Tracking ---
# How often users send presence heartbeat (seconds, default: 60)
PRESENCE_HEARTBEAT_SECONDS=60

# How long until user marked offline (minutes, default: 5)
PRESENCE_TIMEOUT_MINUTES=5

# --- Frontend Feature Flags ---
# Enable milestone celebration UI (default: true)
NEXT_PUBLIC_MILESTONES_ENABLED=true

# Enable circle pooling UI (default: true)
NEXT_PUBLIC_CIRCLE_POOLING_ENABLED=true

# Enable usage-based reviews UI (default: true)
NEXT_PUBLIC_USAGE_REVIEWS_ENABLED=true

# Enable online presence indicators (default: true)
NEXT_PUBLIC_SOCIAL_PRESENCE_ENABLED=true
