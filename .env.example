# PROXYHUB LOCAL PRODUCTION CONFIGURATION
# Copy this file to .env before running scripts/start_prod.ps1

# ==================== PORTS ====================
PORT=8080

# ==================== DATABASE ====================
# For local docker-compose, hostname is 'postgres'
POSTGRES_USER=proxyhubb
POSTGRES_PASSWORD=proxyhubb_secure_pass
POSTGRES_DB=proxyhubb
DATABASE_URL=postgres://proxyhubb:proxyhubb_secure_pass@postgres:5432/proxyhubb?sslmode=disable

# ==================== REDIS ====================
# For local docker-compose, hostname is 'redis'
REDIS_URL=redis://redis:6379

# ==================== SECURITY ====================
# Generate these using `openssl rand -hex 32`
JWT_SECRET=change_this_to_a_secure_random_string
SESSION_SECRET=change_this_to_a_complex_session_secret

# ==================== EXTERNAL URLS ====================
# If using Vercel frontend, set FRONTEND_URL to your Vercel domain.
# If running locally, set to specific port?
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ==================== API KEYS (Optional for Dev, Required for Prod) ====================
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
ORACLE_PRIVATE_KEY=...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
