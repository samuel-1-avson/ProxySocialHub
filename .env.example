# ProxySocialHub Environment Template
# Copy to .env and fill in all values
# DO NOT add real values to this file

# ============================================
# REQUIRED SECRETS (Generate strong values)
# Run: .\scripts\security-setup.ps1
# ============================================
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=
REDIS_URL=
REDIS_PASSWORD=

# ============================================
# SUPABASE CONFIGURATION
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ============================================
# PAYMENT GATEWAYS
# ============================================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ============================================
# OAUTH PROVIDERS
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# SMTP CONFIGURATION
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================
# BLOCKCHAIN
# ============================================
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
SOLANA_PROGRAM_ID=
SOLANA_TREASURY_ADDRESS=
ORACLE_PRIVATE_KEY=
PROVIDER_PRIVATE_KEY=

# ============================================
# EDGE GATEWAY
# ============================================
EDGE_GATEWAY_MGMT_URL=http://edge-gateway:8090

# ============================================
# APPLICATION
# ============================================
APP_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000