# Caddy on the GCE VM — TLS termination for web + API.
# Buyer CONNECT and provider tunnel use edge-gateway ports directly (DNS → VM IP).
# Provider tunnel: TLS on :3128 with Let's Encrypt certs for proxy.* synced into
# /opt/proxyhubb/certs (see scripts/gcp-fix-provider-tunnel.sh). Failover :8443.
#
# Install: apt install caddy
# Copy to /etc/caddy/Caddyfile and: systemctl reload caddy
#
# Canonical web hostname is the apex: https://proxyhubb.com
# Alias hosts (www / app) MUST permanent-redirect to apex so there is one public frontend URL.
#
# Authenticated browser WebSockets must hit api.* (Next on :3000 cannot upgrade WS).
# The web app derives wss://api.proxyhubb.com when served from the apex, or set
# NEXT_PUBLIC_WS_URL / WS_PUBLIC_URL explicitly at image build time.
#
# Cloud DNS A/AAAA (or Cloudflare orange-cloud) → VM external IP for:
#   proxyhubb.com, www.proxyhubb.com, app.proxyhubb.com,
#   api.proxyhubb.com, proxy.proxyhubb.com, docs.proxyhubb.com

# --- Production (ProxyHubb) -------------------------------------------------

proxyhubb.com {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}

www.proxyhubb.com {
	redir https://proxyhubb.com{uri} permanent
}

app.proxyhubb.com {
	redir https://proxyhubb.com{uri} permanent
}

api.proxyhubb.com {
	encode gzip
	# Caddy upgrades WebSocket automatically for /v1/ws
	reverse_proxy 127.0.0.1:8080
}

# Health + note for proxy hostname.
# Provider tunnel is TLS on :3128 (and :8443 failover) with Let's Encrypt certs
# synced from this host into /opt/proxyhubb/certs for edge-gateway.
# Buyer CONNECT remains on :8090 (not this vhost).
proxy.proxyhubb.com {
	respond "ProxyHubb edge — CONNECT :8090 · provider tunnel :3128 (TLS) · failover :8443" 200
}

docs.proxyhubb.com {
	encode gzip
	reverse_proxy 127.0.0.1:3010
}

# --- Testnet template (replace example.com) ---------------------------------
# Point FRONTEND_URL / CORS_ORIGINS / APP_URL at the single apex web host only.
#
# testnet.example.com {
# 	encode gzip
# 	reverse_proxy 127.0.0.1:3000
# }
#
# www.testnet.example.com {
# 	redir https://testnet.example.com{uri} permanent
# }
#
# app.testnet.example.com {
# 	redir https://testnet.example.com{uri} permanent
# }
#
# api.testnet.example.com {
# 	encode gzip
# 	reverse_proxy 127.0.0.1:8080
# }
#
# proxy.testnet.example.com {
# 	respond "ProxyHubb edge — use port 8090 for CONNECT and 3128 for provider tunnel" 200
# }
