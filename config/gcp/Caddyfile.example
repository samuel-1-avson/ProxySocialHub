# Caddy on the GCE VM — TLS termination for web + API.
# Buyer CONNECT and provider tunnel use edge-gateway ports directly (DNS → VM IP).
# Provider tunnel: TLS on :3128 with Let's Encrypt certs for proxy.* synced into
# /opt/proxyhubb/certs (see scripts/gcp-fix-provider-tunnel.sh). Failover :8443.
#
# Install: apt install caddy
# Copy to /etc/caddy/Caddyfile and: systemctl reload caddy
#
# Canonical web hostname is the apex: https://proxyhubb.com
# Alias hosts (www / app) MUST permanent-redirect to apex so there is one public frontend URL.
#
# Authenticated browser WebSockets must hit api.* (Next on :3000 cannot upgrade WS).
# The web app derives wss://api.proxyhubb.com when served from the apex, or set
# NEXT_PUBLIC_WS_URL / WS_PUBLIC_URL explicitly at image build time.
#
# Cloud DNS A/AAAA (or Cloudflare orange-cloud) → VM external IP for:
#   proxyhubb.com, www.proxyhubb.com, app.proxyhubb.com,
#   api.proxyhubb.com, proxy.proxyhubb.com, docs.proxyhubb.com

# --- Production (ProxyHubb) -------------------------------------------------

proxyhubb.com {
	encode gzip
	reverse_proxy 127.0.0.1:3000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 3s
		fail_duration 30s
	}
}

www.proxyhubb.com {
	redir https://proxyhubb.com{uri} permanent
}

app.proxyhubb.com {
	redir https://proxyhubb.com{uri} permanent
}

api.proxyhubb.com {
	encode gzip
	# Prefer failing closed when control-api is down (HA lite).
	# health_uri hits the upstream; dial/response timeouts keep hang time bounded.
	# D.1: /metrics is internal-only (Prometheus scrapes control-api:8080).
	handle /metrics* {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			health_uri /health
			health_interval 15s
			health_timeout 3s
			fail_duration 30s
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
}

# Health + note for proxy hostname.
# Provider tunnel is TLS on :3128 (and :8443 failover) with Let's Encrypt certs
# synced from this host into /opt/proxyhubb/certs for edge-gateway.
# Buyer CONNECT remains on :8090 (not this vhost).
proxy.proxyhubb.com {
	respond "ProxyHubb edge — CONNECT :8090 · provider tunnel :3128/:3129 (TLS) · failover :8443" 200
}

# Wave 2.1 / Sprint J2 — sticky buyer CONNECT across edge-a / edge-b (same VM).
# Publish host :8090 via Caddy → loopback buyer ports from docker-compose.j2-multipod.yml.
# Cookie affinity keeps reconnects on the same pod; providers still dial one tunnel port.
#
# :8090 {
# 	reverse_proxy 127.0.0.1:18090 127.0.0.1:18091 {
# 		lb_policy cookie edge_pod
# 		health_uri /health
# 		health_interval 10s
# 	}
# }
#
# Provider tunnels remain direct DNS → :3128 (edge-a) or :3129 (edge-b).
# Do not claim multi-region HA or multi-operator gateways.


docs.proxyhubb.com {
	encode gzip
	reverse_proxy 127.0.0.1:3010
}

explorer.proxyhubb.com {
	encode gzip
	# Audit S1: the Explorer app sets no security headers itself (unlike the
	# API, whose Go middleware sends its own), so they are added here.
	# img-src allows the OpenStreetMap tile host used by PublicNodeMap;
	# the cloudflareinsights origins are Cloudflare Web Analytics, which
	# Cloudflare injects at the edge. 'unsafe-inline' is required by Next.js
	# (inline RSC payloads) and Leaflet (inline styles).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	}
	reverse_proxy 127.0.0.1:4012
}

# --- Testnet template (replace example.com) ---------------------------------
# Point FRONTEND_URL / CORS_ORIGINS / APP_URL at the single apex web host only.
#
# testnet.example.com {
# 	encode gzip
# 	reverse_proxy 127.0.0.1:3000
# }
#
# www.testnet.example.com {
# 	redir https://testnet.example.com{uri} permanent
# }
#
# app.testnet.example.com {
# 	redir https://testnet.example.com{uri} permanent
# }
#
# api.testnet.example.com {
# 	encode gzip
# 	handle /metrics* {
# 		respond 404
# 	}
# 	handle {
# 		reverse_proxy 127.0.0.1:8080
# 	}
# }
#
# proxy.testnet.example.com {
# 	respond "ProxyHubb edge — use port 8090 for CONNECT and 3128 for provider tunnel" 200
# }
