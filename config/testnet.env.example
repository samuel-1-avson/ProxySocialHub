# Testnet VPS — copy to .env on the server and fill every TESTNET_* / public URL.
# Start: docker compose -f docker-compose.yml -f docker-compose.testnet.yml up -d

# --- Public hostnames (no trailing slash) ---
TESTNET_PUBLIC_HOST=testnet.example.com
API_BASE_URL=https://api.testnet.example.com
FRONTEND_URL=https://app.testnet.example.com
WS_PUBLIC_URL=wss://api.testnet.example.com
GATEWAY_PUBLIC_URL=https://proxy.testnet.example.com

# Buyer CONNECT host:port embedded in order credentials and dashboard copy
EDGE_GATEWAY_BUYER_HOST=proxy.testnet.example.com
EDGE_GATEWAY_BUYER_PORT=8090
NEXT_PUBLIC_PROXY_ENDPOINT=proxy.testnet.example.com:8090

# Remote provider operators paste these into provider.toml (Dashboard → Nodes → Connect)
PROVIDER_PUBLIC_CONTROL_API_URL=https://api.testnet.example.com
PROVIDER_TUNNEL_PUBLIC_ADDR=proxy.testnet.example.com:3128

# --- Solana testnet/devnet ---
SOLANA_NETWORK=devnet
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
NEXT_PUBLIC_SOLANA_PROGRAM_ID=
SOLANA_TREASURY_ADDRESS=

# --- Secrets (generate on server; never commit) ---
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
TOKEN_HMAC_SECRET=
GATEWAY_SHARED_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- CORS / WebSocket origin ---
CORS_ORIGINS=https://app.testnet.example.com
APP_URL=https://app.testnet.example.com

# --- Production-like gates ---
PROXYHUB_ALLOW_DEV_ESCROW_ACTIVATE=false
PROVIDER_SIGNATURE_MODE=enforce
PROXYHUB_REQUIRE_SIGNED_HEARTBEATS=true

# --- CLI distribution (build on CI or run scripts/build-cli-dist.sh on server) ---
CLI_DIST_VERSION=1.0.5
