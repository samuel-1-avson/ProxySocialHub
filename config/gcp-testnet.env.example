# GCP Phase A testnet — copy to .env on the GCE VM (never commit).
# Docs: docs/GCP_TESTNET_PHASE_A.md
#
# Preferred roll (GHCR — single frontend policy):
#   IMAGE_TAG=v1.2.3 ./scripts/gcp-compose-pull-deploy.sh
#   IMAGE_TAG=v1.2.3 ./scripts/gcp-deploy-web.sh          # web only
#
# First-time / emergency on-VM build (no GHCR overlay):
#   docker compose -f docker-compose.yml -f docker-compose.testnet.yml \
#     -f docker-compose.gcp-testnet.yml up -d --build

# --- GCP / VM ---
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
# Static external IP attached to the VM (for Cloud DNS A records)
GCP_VM_EXTERNAL_IP=

# --- Public hostnames (Cloud DNS → VM IP; no trailing slash) ---
# Canonical web URL is a single apex host. Alias hosts (www / app) should
# 301 to FRONTEND_URL via Caddy — see config/gcp/Caddyfile.example.
TESTNET_PUBLIC_HOST=testnet.example.com
API_BASE_URL=https://api.testnet.example.com
FRONTEND_URL=https://testnet.example.com
WS_PUBLIC_URL=wss://api.proxyhubb.com
GATEWAY_PUBLIC_URL=https://proxy.testnet.example.com
# Host Caddy terminates TLS and proxies to 127.0.0.1:8080 — default TRUSTED_PROXIES is loopback.
# TRUSTED_PROXIES=127.0.0.1,::1


# Buyer CONNECT host:port (embedded in order credentials)
EDGE_GATEWAY_BUYER_HOST=proxy.testnet.example.com
EDGE_GATEWAY_BUYER_PORT=8090
EDGE_GATEWAY_TUNNEL_PORT=3128
NEXT_PUBLIC_PROXY_ENDPOINT=proxy.testnet.example.com:8090

# Remote provider.toml hints (Dashboard → Provider → CLI)
PROVIDER_PUBLIC_CONTROL_API_URL=https://api.testnet.example.com
PROVIDER_TUNNEL_PUBLIC_ADDR=proxy.testnet.example.com:3128

# --- Solana public devnet (deploy program first — docs/SOLANA_PROGRAM_DEPLOYMENT.md) ---
SOLANA_NETWORK=devnet
# Prefer a keyed Solana RPC (Helius / QuickNode / Alchemy) as primary.
# Public endpoints are fallbacks only — free tiers 429 under indexer + settle load.
# Example Helius: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Store via: gcloud secrets create proxyhubb-testnet-solana-rpc-url --data-file=-
# Apply: KEYED_RPC_URL=... bash scripts/ops-apply-keyed-rpc.sh
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
SOLANA_RPC_ENDPOINTS=https://api.devnet.solana.com,https://solana-devnet.api.onfinality.io/public
SOLANA_WS_ENDPOINT=wss://api.devnet.solana.com
SOLANA_PROGRAM_ID=
NEXT_PUBLIC_SOLANA_PROGRAM_ID=
SOLANA_TREASURY_ADDRESS=
SOLANA_DEPOSIT_VAULT_ADDRESS=
SOLANA_TREASURY_HOT_ADDRESS=
# After vault cutover: SOLANA_TREASURY_ADDRESS must equal vault PDA (≠ hot).
# Phase 1 deposit vault — gcp-testnet cutover defaults (UI on, legacy credit frozen)
PROXYHUB_DEPOSIT_VAULT_CREDIT_ENABLED=true
PROXYHUB_DEPOSIT_LEGACY_TREASURY_CREDIT=false
PROXYHUB_DEPOSIT_VAULT_UI=true
PROXYHUB_DEPOSIT_REQUIRE_FINALIZED=true
PROXYHUB_REQUIRE_ESCROW_PDA=true
# BC-05: refuse settle when on-chain usage proof anchoring fails
PROXYHUB_REQUIRE_USAGE_PROOF_BEFORE_SETTLE=true
# Buyer hold / challenge window before escrow auto-release (days)
PROXYHUB_ESCROW_CHALLENGE_DAYS=7
# BC-06: amount-gated escrow_multisig + dual-sig settle
PROXYHUB_MULTISIG_SETTLE_ENABLED=true
PROXYHUB_MULTISIG_SETTLE_AMOUNT_LAMPORTS=100000000
PROXYHUB_MULTISIG_COSIGNER_KEYPAIR=/opt/proxyhubb/secrets/multisig-cosigner.json
PROXYHUB_REQUIRE_SESSION_PDA=true

# GCP Cloud KMS oracle (import existing oracle key; see scripts/gcp-kms-oracle-*.sh)
# Sprint E: fail-closed on GCP testnet once key is provisioned.
USE_GCP_KMS=true
GCP_KMS_KEY_NAME=projects/gen-lang-client-0022105784/locations/us-central1/keyRings/proxyhubb-oracle/cryptoKeys/oracle-ed25519/cryptoKeyVersions/1
GCP_KMS_PUBLIC_KEY=8P4uuapgGfW8L7VvdQJ9W7RpJqpfyifhPx9UQaHnKii2
PROXYHUB_REQUIRE_GCP_KMS=true
USE_AWS_KMS=false

# Sprint G/H: treasury-hot SendSOL via Cloud KMS (see scripts/gcp-kms-hot-*.sh)
USE_GCP_KMS_HOT=true
GCP_KMS_HOT_KEY_NAME=projects/gen-lang-client-0022105784/locations/us-central1/keyRings/proxyhubb-treasury/cryptoKeys/hot-ed25519/cryptoKeyVersions/2
GCP_KMS_HOT_PUBLIC_KEY=FeunrDoACmUi4fFQtiw3fPHAqB3N9UrAsj8ZzqSsGPa3
PROXYHUB_REQUIRE_GCP_KMS_HOT=true

# Sprint H: gcp-testnet compose does not mount oracle/hot JSON (volumes !override).
# Leave SOLANA_ORACLE_KEYPAIR / SOLANA_TREASURY_HOT_KEYPAIR empty when KMS REQUIRE is true.
# Off-box + shred: scripts/gcp-kms-keyfile-quarantine.sh then gcp-kms-keyfile-offbox-shred.sh
# Backlog 0.6 FIXED on app VM (SPRINT_06_KEYS_OFFBOX_OK); workstation scrub still unverified.

# --- Database (on-VM Postgres via compose — Phase A only) ---
POSTGRES_USER=proxyhubb
POSTGRES_PASSWORD=
POSTGRES_DB=proxyhubb

# --- Secrets (generate on VM: scripts/gcp-testnet-generate-secrets.sh) ---
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
TOKEN_HMAC_SECRET=
GATEWAY_SHARED_SECRET=
REDIS_PASSWORD=

# --- CORS / WebSocket ---
# Match FRONTEND_URL only (aliases redirect; no need for www/app origins once Caddy is cut over).
CORS_ORIGINS=https://testnet.example.com
APP_URL=https://testnet.example.com

# --- Production-like gates (required for public testnet) ---
PROXYHUB_ALLOW_DEV_ESCROW_ACTIVATE=false
PROXYHUB_ALLOW_DEV_LISTING_SIGN=false
PROVIDER_SIGNATURE_MODE=enforce
PROXYHUB_REQUIRE_SIGNED_HEARTBEATS=true
INDEXER_INDEX_ALL=false

# --- Lean VM (disable ZK prover unless you enable --profile zk) ---
HALO2_PROVER_REQUIRED=false

# --- Explorer / feature flags (conservative for first public testnet) ---
EXPLORER_PUBLIC_SESSIONS_ENABLED=false
EXPLORER_PUBLIC_EARNINGS_ENABLED=false
NEXT_PUBLIC_UNIFIED_NETWORK=false
NEXT_PUBLIC_EXPLORER_MAP_BUY_ENABLED=false

# --- CLI distribution ---
CLI_DIST_VERSION=1.0.5

# --- WalletConnect (public app) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Optional: only if using --profile observability ---
GRAFANA_ADMIN_PASSWORD=
COMPOSE_PROFILES=observability

# --- Alert channels (S3) — at least one recommended on live testnet ---
ALERT_WEBHOOK_URL=
# Platform-native alerts: ops_alerts journal + NATS (no Slack/PagerDuty)
INTERNAL_ALERT_WEBHOOK_TOKEN=
ALERT_ADMIN_EMAILS=
INTERNAL_ALERT_WEBHOOK_TOKEN=
