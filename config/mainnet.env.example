# =============================================================================
# ProxyHubb Production Environment Template — Solana Mainnet-Beta
# Copy to .env on production VMs (NEVER commit live secrets).
# Reference Runbook: docs/operations/MAINNET_DEPLOYMENT_RUNBOOK.md
# =============================================================================

# --- Environment & Network ---
NODE_ENV=production
SOLANA_NETWORK=mainnet-beta

# --- Hostnames & Public URLs (Terminate TLS at Caddy / Cloudflare) ---
PUBLIC_HOST=proxyhubb.com
FRONTEND_URL=https://proxyhubb.com
API_BASE_URL=https://api.proxyhubb.com
WS_PUBLIC_URL=wss://api.proxyhubb.com
GATEWAY_PUBLIC_URL=https://proxy.proxyhubb.com

# --- Solana RPC Configuration (Redundant Keyed Multi-Endpoints) ---
# Primary Keyed Provider (Helius / Triton / QuickNode)
SOLANA_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
SOLANA_RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY,https://solana-mainnet.rpc.extrnode.com,https://api.mainnet-beta.solana.com
SOLANA_WS_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# --- Solana Program & PDA Addresses ---
SOLANA_PROGRAM_ID=AZGhGfvsiGJQ5S91nkdhGi9qvSNKv3sBZyVJ63KQLfvu
NEXT_PUBLIC_SOLANA_PROGRAM_ID=AZGhGfvsiGJQ5S91nkdhGi9qvSNKv3sBZyVJ63KQLfvu
SOLANA_TREASURY_ADDRESS=
SOLANA_DEPOSIT_VAULT_ADDRESS=
SOLANA_TREASURY_HOT_ADDRESS=

# --- Cloud KMS Hardware-Backed Keys (HSM Protection Level) ---
USE_GCP_KMS=true
PROXYHUB_REQUIRE_GCP_KMS=true
GCP_KMS_KEY_NAME=projects/proxyhubb-prod/locations/us-central1/keyRings/proxyhubb-mainnet-keys/cryptoKeys/oracle-mainnet-ed25519/cryptoKeyVersions/1
GCP_KMS_PUBLIC_KEY=

USE_GCP_KMS_HOT=true
PROXYHUB_REQUIRE_GCP_KMS_HOT=true
GCP_KMS_HOT_KEY_NAME=projects/proxyhubb-prod/locations/us-central1/keyRings/proxyhubb-mainnet-keys/cryptoKeys/treasury-hot-mainnet-ed25519/cryptoKeyVersions/1
GCP_KMS_HOT_PUBLIC_KEY=

# --- Fail-Closed Progressive Decentralization Enforcements ---
FULL_DECENTRALIZATION=true
PROXYHUB_PROVIDER_REGISTRY_GATE=enforce
PROXYHUB_PROVIDER_REGISTRY_HEARTBEAT_MAX_AGE=30m
PROXYHUB_JOURNAL_AS_SOT=true
PROXYHUB_JOURNAL_SHADOW_READ=true
PROXYHUB_LISTING_COMMITMENT=enforce
PROXYHUB_BROWSE_REGISTRY_FILTER=enforce
PROXYHUB_GATEWAY_OPERATOR_BOND_ENFORCE=enforce
PROXYHUB_OPERATOR_MANIFEST=enforce

# --- Escrow & State-Channel Parameters ---
PROXYHUB_REQUIRE_ESCROW_PDA=true
PROXYHUB_REQUIRE_SESSION_PDA=true
PROXYHUB_REQUIRE_USAGE_PROOF_BEFORE_SETTLE=true
PROXYHUB_DEPOSIT_VAULT_CREDIT_ENABLED=true
PROXYHUB_DEPOSIT_REQUIRE_FINALIZED=true
PROXYHUB_ESCROW_CHALLENGE_DAYS=7

# --- Database & Redis HA Cluster ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=proxyhubb_prod
POSTGRES_PASSWORD=
POSTGRES_DB=proxyhubb_prod
POSTGRES_SSLMODE=require

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# --- Secrets (Generate with `openssl rand -hex 32`) ---
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
TOKEN_HMAC_SECRET=
EMAIL_HASH_PEPPER=
GATEWAY_SHARED_SECRET=
ADMIN_API_SECRET=
MAXMIND_LICENSE_KEY=

