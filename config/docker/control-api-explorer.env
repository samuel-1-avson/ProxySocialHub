# Explorer defaults for Docker (control-api).
# Override via project .env or compose environment: entries there take precedence.
# Dev compose sets EXPLORER_PUBLIC_SESSIONS_ENABLED=true; production compose defaults to false.

FULL_DECENTRALIZATION=false
EXPLORER_PUBLIC_SESSIONS_ENABLED=true
EXPLORER_PUBLIC_EARNINGS_ENABLED=false
EXPLORER_MIN_WRITERS=2
EXPLORER_METRICS_ENABLED=true
EXPLORER_METRICS_INTERVAL=10m
EXPLORER_INDEXER_ENABLED=true
EXPLORER_INDEXER_POLL_INTERVAL_MS=5000
EXPLORER_WS_MAX_CLIENTS=500
EXPLORER_WS_MAX_PER_IP=15
