[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = GH
ST = Greater Accra
L = Accra
O = ProxyHub
OU = Edge Gateway
CN = gateway.proxyhubb.com

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = gateway.proxyhubb.com
DNS.2 = *.proxyhubb.com
DNS.3 = localhost
IP.1 = 127.0.0.1
IP.2 = 0.0.0.0
