# =============================================================================
# ProxyHubb Docker Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# These settings are used by docker-compose.yml
# =============================================================================

# =============================================================================
# API Configuration
# =============================================================================

# Base URL for API (external access from browser)
# Host port for control-api (container still listens on 8080). Avoid 8080 if another stack uses it.
CONTROL_API_PORT=18080
API_BASE_URL=http://localhost:18080

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://proxyhubb:proxyhubb@postgres:5432/proxyhubb?sslmode=disable

# PostgreSQL credentials (must match above)
POSTGRES_USER=proxyhubb
POSTGRES_PASSWORD=proxyhubb
POSTGRES_DB=proxyhubb

# =============================================================================
# Security - CHANGE THESE FOR PRODUCTION!
# =============================================================================

# JWT Secret — generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Dedicated control-plane secret for edge-gateway -> control-api gateway routes
GATEWAY_SHARED_SECRET=your-gateway-shared-secret-change-this

# Session Secret — generate with: openssl rand -hex 32
# Used for session-intent JWT signing/validation, separate from gateway auth.
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Encryption key for session credentials — generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-super-secret-encryption-key-change-this

# HMAC key for provider CLI tokens — generate with: openssl rand -hex 32 (REQUIRED)
TOKEN_HMAC_SECRET=your-token-hmac-secret-change-this
EMAIL_HASH_PEPPER=your-email-hash-pepper-change-this

# Redis password (REQUIRED — Redis runs in auth-only mode)
REDIS_PASSWORD=change-this-redis-password

# =============================================================================
# Solana / Blockchain Configuration
# =============================================================================

# Solana network (mainnet, devnet, testnet)
SOLANA_NETWORK=devnet

# Solana RPC endpoint
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

# Solana Program ID
SOLANA_PROGRAM_ID=AZGhGfvsiGJQ5S91nkdhGi9qvSNKv3sBZyVJ63KQLfvu

# Treasury wallet address (for receiving deposits) — must differ from oracle pubkey in production
SOLANA_TREASURY_ADDRESS=your-treasury-wallet-address
SOLANA_TREASURY_HOT_ADDRESS=your-treasury-hot-wallet-address
SOLANA_TREASURY_COLD_ADDRESS=
# Hot float / vault→hot (compose defaults: staging-friendly 5/50/15)
SOLANA_TREASURY_HOT_MIN_BALANCE=5
SOLANA_TREASURY_HOT_MAX_BALANCE=50
SOLANA_TREASURY_REPLENISH_AMOUNT=15
SOLANA_VAULT_TOPUP_MAX_SOL=20
SOLANA_VAULT_DAILY_TOPUP_CAP_SOL=200
SOLANA_VAULT_RESERVE_FLOOR_SOL=0.01
SOLANA_TREASURY_SWEEP_ENABLED=true
# Path inside container (mount host treasury-keypair.json). Required when APP_ENV=production.
SOLANA_TREASURY_HOT_KEYPAIR=

# =============================================================================
# Supabase Configuration
# =============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# OAuth Providers (Optional)
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# Email Configuration (Optional)
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# =============================================================================
# Admin Panel Credentials
# =============================================================================

ADMIN_JWT_SECRET=admin-jwt-secret-change-this

# Admin Account 1 (Super Admin)
ADMIN_ACCOUNT_1_USERNAME=admin
ADMIN_ACCOUNT_1_PASSWORD=change-this-password
ADMIN_ACCOUNT_1_ROLE=super_admin
ADMIN_ACCOUNT_1_TOTP_SECRET=        # base32 TOTP secret — leave blank to disable MFA

# Admin Account 2 (Support)
ADMIN_ACCOUNT_2_USERNAME=support
ADMIN_ACCOUNT_2_PASSWORD=change-this-password
ADMIN_ACCOUNT_2_ROLE=support
ADMIN_ACCOUNT_2_TOTP_SECRET=        # base32 TOTP secret — leave blank to disable MFA

# Admin Account 3 (Viewer)
ADMIN_ACCOUNT_3_USERNAME=viewer
ADMIN_ACCOUNT_3_PASSWORD=change-this-password
ADMIN_ACCOUNT_3_ROLE=viewer
ADMIN_ACCOUNT_3_TOTP_SECRET=        # base32 TOTP secret — leave blank to disable MFA

# =============================================================================
# Edge Gateway Configuration
# =============================================================================

# Provider private key (for development only!)
# REQUIRED: hex Ed25519 seed for usage-report signing. Generate with:
#   node scripts/gateway-usage-keygen.cjs
# Never use the all-zeros seed — its pubkey is publicly known, so anyone could
# forge "validly signed" usage reports (metering/billing forgery).
PROVIDER_PRIVATE_KEY=

# Public buyer proxy URL (edge-gateway PORT=8090 — HTTP CONNECT/WS + health/metrics).
# Provider tunnels use the separate TUNNEL_PORT=3128 (see PROXYHUB_GATEWAY_ADDRS below).
GATEWAY_PUBLIC_URL=http://localhost:8090

# Host port bound to edge-gateway internal port 8090 (API / metrics / health / ready)
EDGE_GATEWAY_PORT=8090

# P6 optional buyer ingress (SOCKS5 on :1080 inside container)
# ENABLE_SOCKS5=1
# EDGE_GATEWAY_SOCKS5_PORT=1080

# Load-lab soak (10k+ CONNECT hold) — set on dedicated ops host only
# MAX_CONCURRENT_CONNECTIONS=16384

# P5 OpenTelemetry (optional): rebuild edge-gateway with EDGE_GATEWAY_ENABLE_OTEL=1
# EDGE_GATEWAY_ENABLE_OTEL=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=edge-gateway

# Geo restrictions (comma-separated ISO country codes)
# GEO_DENY_LIST=CN,RU,KP
# GEO_ALLOW_LIST=GH,US,GB,DE

# Gateway region identifier
REGION=af-west-1

# MaxMind GeoLite2 license key — enables weekly GeoIP database auto-update in the container
# Get a free key at: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# P2-12: Per-operation timeouts (seconds) — safe defaults shown
PROXY_CONNECT_TIMEOUT_SECS=10   # TCP dial timeout to upstream provider node
PROXY_IDLE_TIMEOUT_SECS=60      # Close tunnel after this many idle seconds
RPC_REQUEST_TIMEOUT_SECS=15     # HTTP timeout for Control-API / RPC calls

# =============================================================================
# Price Feed APIs (Optional)
# =============================================================================

# D-O1: Multi-source price oracle (edge-gateway reads all three concurrently → median)
# CoinGecko: optional key; free tier works without one but rate-limited (1 req/min)
COINGECKO_API_KEY=your-coingecko-api-key
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# CoinMarketCap: optional; skipped gracefully when absent (2-source median still valid)
COINMARKETCAP_API_KEY=your-cmc-api-key

# =============================================================================
# Oracle Velocity Guard (Security limits on SOL transfers)
# =============================================================================

# Hard cap per single transaction (SOL)
ORACLE_MAX_SINGLE_TRANSFER_SOL=50

# Rolling 1-hour outflow cap (SOL)
ORACLE_MAX_HOURLY_OUTFLOW_SOL=500

# Set to "true" to freeze ALL oracle transfers immediately (emergency use)
ORACLE_TRANSFER_FREEZE=false

# Set to "true" to disable centralized fallbacks and require chain-authoritative flows
FULL_DECENTRALIZATION=false

# Access Passes (NFT entitlement — replaces custodial subscriptions)
MINT_BRONZE_PASS=
MINT_SILVER_PASS=
MINT_GOLD_PASS=
MINT_PREMIUM_PASS=
PASS_BRONZE_PRICE_SOL=0.5
PASS_SILVER_PRICE_SOL=2.0
PASS_GOLD_PRICE_SOL=5.0
PASS_BRONZE_PURCHASE_URL=
PASS_SILVER_PURCHASE_URL=
PASS_GOLD_PURCHASE_URL=

# =============================================================================
# Web UI (Next.js — rebuild `web` image after navigation/settings changes)
# =============================================================================
# Production images bake NEXT_PUBLIC_* at build time (see apps/web/Dockerfile).
# After pulling UI changes: .\scripts\docker-refresh-stack.ps1 -Services web
#
NEXT_PUBLIC_EXPLORER_PUBLIC_SESSIONS_ENABLED=true
NEXT_PUBLIC_EXPLORER_PUBLIC_EARNINGS_ENABLED=false
# In-map purchase on /explorer/map (canonical buy flow: /marketplace/map)
EXPLORER_MAP_BUY_ENABLED=false

# Explorer public API (docker-compose.dev.yml defaults sessions to true; prod compose to false)
EXPLORER_PUBLIC_SESSIONS_ENABLED=true
EXPLORER_PUBLIC_EARNINGS_ENABLED=false
EXPLORER_MIN_WRITERS=2
EXPLORER_METRICS_ENABLED=true
EXPLORER_METRICS_INTERVAL=10m
EXPLORER_INDEXER_ENABLED=true
EXPLORER_INDEXER_POLL_INTERVAL_MS=5000
EXPLORER_WS_MAX_CLIENTS=500
EXPLORER_WS_MAX_PER_IP=15

# Public WebSocket URL for explorer live updates (browser must reach the host, not control-api:8080)
WS_PUBLIC_URL=ws://localhost:18080

# =============================================================================
# Alert Channels (Recommended for production)
# =============================================================================

# Optional self-hosted alert webhook (ntfy / Matrix / custom) — not Slack
ALERT_WEBHOOK_URL=

# Comma-separated admin emails (optional; journal+NATS is the default path)
ALERT_ADMIN_EMAILS=

# Platform-native: durable ops_alerts + NATS proxy.ops.v1.alerts
INTERNAL_ALERT_WEBHOOK_TOKEN=

# SMTP credentials used by optional mail (can match SMTP_USER/SMTP_PASS above)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# =============================================================================
# Emergency Fallback
# =============================================================================

# Emergency SOL price in USD — used ONLY when all live price feeds fail
EMERGENCY_SOL_PRICE_USD=200

# =============================================================================
# Migrations
# =============================================================================
# Path inside the container where *.up.sql migration files are mounted.
# The db-migrate service mounts ./migrations here automatically.
# Override only if you mount migrations to a different path.
MIGRATIONS_DIR=/app/migrations

# =============================================================================
# Platform Token
# =============================================================================
# SPL token mint address for the ProxyHub platform token (PHB).
# Leave blank if the token has not been deployed yet.
PHB_TOKEN_MINT=

# =============================================================================
# WebSocket / Real-time
# =============================================================================
# Public WebSocket URL used by the browser for the real-time explorer.
# In production set to wss://api.proxyhubb.com (browser-reachable API host with WS upgrade).
# Do NOT point this at the Next.js apex — Next rewrites are HTTP-only.
WS_PUBLIC_URL=wss://api.proxyhubb.com

# =============================================================================
# Provider Engine
# =============================================================================
# Supabase JWT secret — required for provider token auth middleware.
# Find it in: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Platform fee taken from each provider payout (0.0–1.0, default 10%)
PLATFORM_FEE_PERCENT=0.10

# Minimum SOL amount before a provider payout is disbursed
MIN_PAYOUT_SOL=0.01

# Payouts grouped per Solana transaction
PAYOUT_BATCH_SIZE=20

# =============================================================================
# GeoIP Backfill Worker
# =============================================================================
# Resolves lat/lon for explorer nodes via ip-api.com (free, 45 req/min).
# Set to "false" in air-gapped environments.
GEOIP_ENABLED=true

# =============================================================================
# Map topology (Phase 5 — globe session arcs)
# =============================================================================
# Backend worker aggregates active session_intents into map_node_links (migration 000099).
# Disable in air-gapped or low-resource environments.
MAP_TOPOLOGY_ENABLED=true

# Draw real session arcs on the 3D explorer globe (requires web image rebuild).
# Baked at Next.js build time — changing this alone requires: docker compose build web
# docker-compose.dev.yml defaults to true for staging-style validation; production compose defaults false.
NEXT_PUBLIC_GLOBE_TOPOLOGY=true

# Optional: live map pins on marketplace map (separate from globe topology).
NEXT_PUBLIC_MAP_LIVE_ON_MARKETPLACE=false

# =============================================================================
# Grafana / alerting (optional SMTP for contact points)
# =============================================================================
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# Enable email delivery for provisioned contact points (see infra/grafana/alerting/README.md)
# GRAFANA_SMTP_ENABLED=true
# GRAFANA_SMTP_HOST=smtp.example.com:587
# GRAFANA_SMTP_USER=
# GRAFANA_SMTP_PASSWORD=
# GRAFANA_SMTP_FROM=alerts@yourdomain.com
# GRAFANA_SMTP_FROM_NAME=ProxyHubb Alerts

# =============================================================================
# Provider proofs (Phase 1 — signed heartbeats / listings)
# =============================================================================
# observe = verify and store proof metadata (default)
# enforce = reject invalid proofs when the node has a registered hotkey
# observe = log-only proofs; enforce = require signed heartbeats/listing offers (staging soak: STAGING_ENFORCE_RUNBOOK.md)
PROVIDER_SIGNATURE_MODE=observe
# PROXYHUB_REQUIRE_SIGNED_HEARTBEATS=true

# Gateway: reject unsigned provider heartbeats when true (gradual rollout)
PROXYHUB_REQUIRE_SIGNED_HEARTBEATS=false

# Optional Docker provider-node (see docker-compose.provider.yml):
#   .\scripts\bootstrap-provider-docker.ps1 -StartProvider
# Credentials are written to config/docker/provider.compose.env (gitignored).

# =============================================================================
# Provider Node (CLI daemon — optional Docker profile or host-run)
# =============================================================================
# Provider nodes are standalone Rust daemons run by bandwidth providers on their
# own machines. They connect outbound to the edge-gateway tunnel port (TUNNEL_PORT=3128).
#
# D-GW: Multi-gateway failover — pass a comma-separated ordered list of
# gateway addresses. The daemon rotates through these on each reconnect so a
# single gateway outage does not take the provider offline.
#
# When running provider-node alongside this Docker stack, use the container name:
#   PROXYHUB_GATEWAY_ADDRS=edge-gateway:3128
# For production with multiple gateways:
#   PROXYHUB_GATEWAY_ADDRS=gw1.proxyhubb.com:3128,gw2.proxyhubb.com:3128
PROXYHUB_GATEWAY_ADDRS=edge-gateway:3128

# P4: Parallel yamux tunnels per provider (gateway + provider-node; max 16, default 1).
# Set the same value on edge-gateway and provider-node for multi-lane throughput.
# YAMUX_CONNS_PER_NODE=2

# D-L1: Leader election NATS fallback (edge-gateway)
# When Redis is unreachable for 3+ consecutive ticks the gateway switches to
# NATS JetStream KV-based leader election. This variable is already set to the
# internal NATS container in docker-compose — only override for external NATS.
# NATS_URL=nats://nats:4222
