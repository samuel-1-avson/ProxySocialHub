{
  "name": "proxyhubb-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "ProxyHubb MCP server: verified residential proxy sessions for AI agents (geo, rotation, budget caps), settled on Solana.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "proxyhubb-mcp": "src/server.ts"
  },
  "scripts": {
