# ProxyHubb MCP server configuration. Copy the values you need into your MCP
# client's env block for this server (see README). Never commit real values.

# Control API base URL (default: https://api.proxyhubb.com)
PROXYHUBB_BASE_URL=https://api.proxyhubb.com

# Buyer gateway host:port (default: proxy.proxyhubb.com:8090)
PROXYHUBB_PROXY_ENDPOINT=proxy.proxyhubb.com:8090

# Dashboard JWT (Bearer). REQUIRED for create_agent_session — session intents
# are minted as your account, so plan limits and escrow rules apply. Copy it from
# your signed-in website session (README: "Getting your access token"), not from
# the provider app or CLI: a provider node token is refused on these routes.
PROXYHUBB_ACCESS_TOKEN=

# Optional scoped machine API key (phub_…), sent as X-API-Key when set. With
# the orders:create scope it is enough for list_my_orders / use_my_order, so an
# agent that only runs on paid orders does not need your JWT. Note that the same
# scope also lets the key create, pay for and cancel orders (this server never does).
PROXYHUBB_API_KEY=

# HTTPS IP-echo used by verify_exit (default: https://api.ipify.org?format=json)
PROXYHUBB_ECHO_URL=https://api.ipify.org?format=json

# Per-request timeout in ms (default: 15000)
PROXYHUBB_TIMEOUT_MS=15000
