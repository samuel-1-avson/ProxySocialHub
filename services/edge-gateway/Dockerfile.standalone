# Standalone Dockerfile for edge-gateway
# Uses project root as context to access proto files

FROM rust:1.84-alpine AS builder

WORKDIR /app
RUN apk add --no-cache musl-dev protoc protobuf-dev openssl-dev openssl-libs-static pkgconfig

# Copy proto files
COPY proto ./proto

# Copy edge-gateway source
COPY services/edge-gateway/Cargo.toml services/edge-gateway/Cargo.lock ./
COPY services/edge-gateway/build.rs ./
COPY services/edge-gateway/src ./src

# Build
RUN cargo build --release

FROM alpine:latest
RUN apk --no-cache add curl ca-certificates
COPY --from=builder /app/target/release/edge-gateway /usr/local/bin/
EXPOSE 3128 8090
CMD ["edge-gateway"]
