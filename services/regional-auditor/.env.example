# ProxyHubb Regional Auditor: example configuration. No secrets here; copy the
# variables you need into your process environment or secret store.
# Anything marked REQUIRED must be set or the feature reports itself unavailable.

# --- Service -------------------------------------------------------------------
AUDITOR_HOST=127.0.0.1
AUDITOR_PORT=4021
# REQUIRED. >= 32 random characters, shared ONLY with the web server (AUDITOR_SERVICE_SECRET there).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDITOR_SERVICE_SECRET=
# Job documents (filesystem store) and private screenshots. Gitignored; never served statically.
AUDITOR_DATA_DIR=./.data
# Optional. When set, jobs are stored in PostgreSQL (apply migrations/000176_regional_audits.up.sql);
# otherwise the filesystem store is used.
AUDITOR_DATABASE_URL=
# Finished audits and their screenshots older than this many days are deleted (checked at start and every 6 h). 0 keeps everything.
AUDITOR_RETENTION_DAYS=30

# --- Live mode (ProxyHubb regional sessions) ---------------------------------------
# REQUIRED for live audits: the buyer gateway as host:port (HTTP CONNECT). Never taken from a request.
AUDITOR_PROXY_ENDPOINT=
# REQUIRED for live audits: comma-separated HTTPS origins that may be audited. Everything else is refused.
AUDITOR_ALLOWED_TARGET_ORIGINS=
# Extra HTTPS origins a page may load (CDNs, fonts). Anything not listed is blocked and shown as "blocked by audit policy".
AUDITOR_ALLOWED_SUBRESOURCE_ORIGINS=
# Fetched THROUGH the browser to observe its exit IP (and once directly, to detect proxy bypass).
AUDITOR_EGRESS_ECHO_URL=https://api.ipify.org/?format=json
# ipwhois (free public GeoIP estimate) or none. A GeoIP result is an estimate, not proof of location.
AUDITOR_GEOIP_PROVIDER=ipwhois
# Allow POST/PUT/... sub-requests (default 0: audits are read-only).
AUDITOR_ALLOW_NON_READ_ONLY_SUBREQUESTS=0
# Path to a Chrome/Chromium binary if Playwright's bundled browser is not installed.
AUDITOR_CHROME_PATH=

# --- Development fixture harness (NEVER in production) ----------------------------
# Starts a controlled demo site + local fixture proxy in-process. Refused when NODE_ENV=production.
AUDITOR_FIXTURE_ENABLED=0
AUDITOR_FIXTURE_TARGET_PORT=
AUDITOR_FIXTURE_SCENARIO=demo-v1

# --- Meta Model API ---------------------------------------------------------------
# Server-side only. Never expose through a NEXT_PUBLIC_ variable.
MODEL_API_KEY=
AUDITOR_MODEL_BASE_URL=https://api.meta.ai/v1
# Standard mode: Meta does not use your content to train models. "-contributor" models do, and are
# refused unless AUDITOR_ALLOW_CONTRIBUTOR_MODE=1 is set deliberately.
AUDITOR_MODEL=muse-spark-1.3
AUDITOR_ALLOW_CONTRIBUTOR_MODE=0
AUDITOR_MODEL_REASONING_EFFORT=low
# Reasoning tokens count against this budget.
AUDITOR_MODEL_MAX_OUTPUT_TOKENS=8000
AUDITOR_MODEL_TIMEOUT_MS=90000
AUDITOR_MODEL_MAX_RETRIES=2
# Hard cap on model HTTP calls per audit across planning, analysis, retries and re-analysis.
AUDITOR_MAX_MODEL_CALLS_PER_JOB=10
# Optional price list (USD per million tokens) for the cost ESTIMATE shown in reports. Defaults to the
# documented Muse Spark 1.3 standard prices; verify at https://dev.meta.ai/docs/pricing-rate-limits.
AUDITOR_PRICE_INPUT_PER_MTOK_USD=
AUDITOR_PRICE_CACHED_PER_MTOK_USD=
AUDITOR_PRICE_OUTPUT_PER_MTOK_USD=
AUDITOR_PRICE_SOURCE=

# --- Limits (all optional; defaults shown) -----------------------------------------
AUDITOR_MAX_REGIONS=2
AUDITOR_MAX_CHECKS=6
AUDITOR_MAX_CONCURRENT_JOBS=1
AUDITOR_MAX_CONCURRENT_BROWSERS=2
AUDITOR_MAX_QUEUE=20
AUDITOR_MAX_ACTIVE_JOBS_PER_OWNER=2
AUDITOR_CREATES_PER_OWNER_PER_HOUR=20
AUDITOR_NAV_TIMEOUT_MS=30000
AUDITOR_CHECK_TIMEOUT_MS=8000
AUDITOR_JOB_TIMEOUT_MS=240000
AUDITOR_MAX_REQUESTS_PER_REGION=150
AUDITOR_MAX_BYTES_PER_REGION=15728640
AUDITOR_MAX_REDIRECTS=5
AUDITOR_MAX_BODY_BYTES=65536
AUDITOR_MAX_VISIBLE_TEXT_CHARS=6000
