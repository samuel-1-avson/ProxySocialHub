{
  "name": "@proxyhubb/regional-auditor",
  "version": "0.1.0",
  "private": true,
  "description": "ProxyHubb Regional Auditor: bounded browser worker that checks an authorized website through regional provider networks and produces an evidence-backed report.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "demo-target": "node src/fixtures/demoTargetCli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "eval": "node src/eval/cli.ts",
    "preflight": "node src/preflightCli.ts",
    "stack": "node scripts/stack.mjs",
    "inspect": "node src/inspectCli.ts"
  },
  "dependencies": {
    "pg": "^8.17.2",
    "playwright-core": "1.57.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}
