PORT=8080
DATABASE_URL=postgres://user:password@hostname:5432/dbname?sslmode=disable
REDIS_URL=redis://localhost:6379
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=your-jwt-secret
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_HOURS=720
GATEWAY_SHARED_SECRET=your-gateway-shared-secret
# New listing publication requires a successful, accepted proxy assessment.
# Use observe explicitly during a measured rollout; existing purchases are untouched.
LISTING_QUALITY_MODE=enforce
# Management endpoint shared with provider ping; never supplied by a provider.
EDGE_GATEWAY_MGMT_URL=http://edge-gateway:8090
SESSION_SECRET=your-session-secret
# Session-intent JWTs are signed with SESSION_SECRET so they do not share
# blast radius with the edge-gateway control-plane auth secret above.
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
ORACLE_PRIVATE_KEY=your-oracle-private-key
BITTENSOR_BRIDGE_URL=http://localhost:8002
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
FROM_EMAIL=no-reply@example.com

# Manual provider claim endpoints (POST /v1/provider/claim/prepare and /confirm).
# Off by default: they pay pending earnings from the treasury on top of the other
# payout paths (BE-CRIT-02). Leave unset until the payout path is unified.
# ENABLE_PROVIDER_CLAIM=false
