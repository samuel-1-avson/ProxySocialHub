# Dockerfile.simple — legacy name; same build as Dockerfile.
# Build from repository root:
#   docker build -f services/control-api/Dockerfile.simple .

FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

COPY services/control-api/go.mod services/control-api/go.sum ./
RUN go mod download

COPY services/control-api/ .
RUN rm -rf vendor

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -a -installsuffix cgo \
    -o server \
    main.go

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget && \
    adduser -D -u 1000 -g '' appuser

WORKDIR /app

COPY --from=builder /app/server ./server
COPY migrations /app/migrations

RUN chown -R appuser:appuser /app

USER appuser

ENV MIGRATIONS_DIR=/app/migrations

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./server"]
